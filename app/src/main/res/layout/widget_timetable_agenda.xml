<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_agenda_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_agenda_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thứ Hai • Hôm nay"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_agenda_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="3 Môn"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_agenda_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Làm mới"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_agenda_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Không có tiết học nào hôm nay 🎉\nChúc bạn ngày mới tràn đầy năng lượng!"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- List container with up to 3 slots -->
    <LinearLayout
        android:id="@+id/widget_agenda_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Slot 1 -->
        <LinearLayout
            android:id="@+id/slot_1_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_agenda_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <View
                android:id="@+id/slot_1_stripe"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#38BDF8" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Toán Cao Cấp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_1_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="08:00 - 09:30 • P.A201"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_1_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Sắp tới"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slot 2 -->
        <LinearLayout
            android:id="@+id/slot_2_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_agenda_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <View
                android:id="@+id/slot_2_stripe"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#10B981" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Lập Trình Di Động"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_2_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="10:00 - 11:30 • P.B102"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_2_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Hôm nay"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Slot 3 -->
        <LinearLayout
            android:id="@+id/slot_3_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_agenda_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <View
                android:id="@+id/slot_3_stripe"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#EC4899" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tiếng Anh Chuyên Ngành"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_3_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="13:30 - 15:00 • P.C301"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_3_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Chiều nay"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
